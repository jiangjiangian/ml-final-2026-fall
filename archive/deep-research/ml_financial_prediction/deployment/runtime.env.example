# Copy to ~/.config/finpred/runtime.env on the chosen persistent Linux host.
# chmod 600 that file. These are examples, not an installed service configuration.
FINPRED_PROJECT_ROOT=/absolute/path/ml-final-2026-fall/ml_financial_prediction
FINPRED_RUNTIME_ROOT=/absolute/path/private/finpred-runtime
FINPRED_ENABLE_SUBMIT=0
# Optional table overrides; omitted paths trigger private raw-to-daily preparation.
# Current observed-fetch evidence never certifies historical publication/vintages.
# Strict training remains blocked until verified historical data is supplied.
# Keep all tables and source evidence private, outside Git.
# FINPRED_TRAINING_TABLE=/absolute/path/verified-training-table.json
# FINPRED_PREDICTION_TABLE=/absolute/path/verified-prediction-table.json
# FINPRED_CSV=/absolute/path/validated-prediction.csv
# COURSE_EMAIL and COURSE_PASSWORD must be supplied as secrets on that host.
# This repository intentionally contains no actual credentials.
