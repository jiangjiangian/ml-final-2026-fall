# 未啟用範本；尚未具備資料adapter、模型、儲存與提交程式。
# 補完OPERATIONS.md的部署前置條件後，才移除.example並放到default branch。
name: daily-market-pipeline-template
on:
  workflow_dispatch:
  schedule:
    # UTC 20:17/21:17/22:17/23:17 = 台灣次日04:17/05:17/06:17/07:17
    - cron: '17 20-23 * * *'
    # UTC 00:10/00:35 = 台灣同日08:10/08:35
    - cron: '10,35 0 * * *'
permissions:
  contents: read
concurrency:
  group: daily-market-pipeline
  cancel-in-progress: false
jobs:
  template-guard:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - name: Require implementation before activation
        shell: bash
        run: |
          echo 'Template only. Implement and verify the pipeline in docs/OPERATIONS.md first.'
          exit 1
# 待實作：Asia/Taipei目標session gate、公開來源抓取、available_at檢查、
# durable snapshots、M0特徵、凍結模型、CSV驗證、dry_run、回執、跨runner提交鎖。
# 禁止在此範本放帳密、token、cookie或猜測的競賽提交URL。
