# Python 快取和虛擬環境
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ipynb_checkpoints/

# 帳號密碼
.env

# 爬蟲解壓和寫檔時的暫存（正常結束會自己刪掉）
data/raw/.*.new/
data/raw/.*.old/
data/raw/**/.*.tmp

# 可以從 data/raw/ 重算的特徵表
data/processed/*
!data/processed/.gitkeep

# yfinance 的時區快取（config.yaml 的 yfinance.cache_dir）
.cache/

# 編輯器
.vscode/
.idea/
.DS_Store

# Claude Code：skill 只裝在本機，不上傳；個人設定不上傳
.claude/skills/
.claude/settings.local.json
graphify-out/

# data/raw/、data/submission/、models/ 都要進 Git（原因見 memory/context/data-rules.md「資料放在這個分支」）
