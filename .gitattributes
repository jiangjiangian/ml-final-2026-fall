# 原始資料位元組原樣保存：Git 不改換行（Live 的 CSV 是 CRLF），manifest 的 sha256 才對得上
data/raw/** -text
# tests/fixtures/ 是 data-collection 的凍結快照，原樣保存，不改換行
tests/fixtures/** -text
# 上傳紀錄只會往後加；兩台主機（GCP、Mac 備援）同時加時，rebase 用 union 把兩邊的行都留下
data/submission/upload_log.jsonl merge=union
# 每天的執行紀錄也只往後加（爬蟲、特徵、run_daily_test 都會寫），兩邊的行都留下
data/submission/run_*.log merge=union
