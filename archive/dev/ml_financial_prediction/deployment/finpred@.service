[Unit]
Description=Financial prediction pipeline stage %i
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/finpred/runtime.env
ExecStart=/usr/bin/env bash ${FINPRED_PROJECT_ROOT}/deployment/run-stage.sh %i
UMask=0077
TimeoutStartSec=35min
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
